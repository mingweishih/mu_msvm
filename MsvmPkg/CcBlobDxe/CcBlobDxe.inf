[Defines]
  INF_VERSION                    = 0x00010016
  BASE_NAME                      = CcBlobDxe
  FILE_GUID                      = 5C7B3A1F-7C12-4D6A-8E54-7D1F5A2C9E03
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = CcBlobDxeEntry

#
#  VALID_ARCHITECTURES           = X64
#

[Sources]
  CcBlobDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MsvmPkg/MsvmPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IsolationLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Depex]
  TRUE
